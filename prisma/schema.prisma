generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Auth.js Models ────────────────────────────────────────────────────────
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  memberships   WorkspaceMember[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── ScopeBridge Core Models ─────────────────────────────────────────────

model Workspace {
  id               String             @id @default(cuid())
  name             String
  slug             String             @unique
  members          WorkspaceMember[]
  connectedAccounts ConnectedAccount[]
  sourceItems      SourceItem[]
  auditRuns        AuditRun[]
  risks            DeliveryRisk[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        String    @default("MEMBER") // OWNER, ADMIN, MEMBER
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model ConnectedAccount {
  id                   String    @id @default(cuid())
  workspaceId          String
  provider             String    // gmail, slack, github
  providerAccountId    String
  encryptedAccessToken String    @db.Text
  encryptedRefreshToken String?  @db.Text
  expiresAt            DateTime?
  scopes               String?
  status               String    @default("active") // active, error, disconnected
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([workspaceId, provider, providerAccountId])
}

model SourceItem {
  id          String    @id @default(cuid())
  workspaceId String
  sourceType  String    // gmail, slack, github, manual, upload
  externalId  String?
  title       String
  content     String    @db.Text
  author      String?
  url         String?
  metadata    Json?
  occurredAt  DateTime
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AuditRun {
  id               String         @id @default(cuid())
  workspaceId      String
  status           String         @default("running") // running, complete, failed
  sourceEventCount Int            @default(0)
  risksFound       Int            @default(0)
  risks            DeliveryRisk[]
  workspace        Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model DeliveryRisk {
  id                 String         @id @default(cuid())
  workspaceId        String
  auditRunId         String?
  type               String         // missing_ticket, scope_drift, contradiction, blocker, deadline_risk, ownership_gap, forgotten_commitment
  severity           String         // low, medium, high, critical
  title              String
  clientPromise      String         @db.Text
  engineeringReality String         @db.Text
  evidenceQuote      String         @db.Text
  confidence         Float
  recommendedAction  String         @db.Text
  status             String         @default("active") // active, reviewed, mitigated
  actionDrafts       ActionDraft[]
  actionExecutions   ActionExecution[]
  workspace          Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  auditRun           AuditRun?      @relation(fields: [auditRunId], references: [id], onDelete: SetNull)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model ActionDraft {
  id          String       @id @default(cuid())
  riskId      String
  type        String       // email, slack, github_issue, github_pr
  title       String
  body        String       @db.Text
  target      String?      // e.g., email address, slack channel id, github repo name
  risk        DeliveryRisk @relation(fields: [riskId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model ActionExecution {
  id          String       @id @default(cuid())
  riskId      String
  type        String       // email, slack, github_issue, github_pr
  status      String       // pending, success, failed
  externalUrl String?
  errorMsg    String?      @db.Text
  risk        DeliveryRisk @relation(fields: [riskId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}
