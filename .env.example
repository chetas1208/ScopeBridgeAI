# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/scopebridge

# ── Auth ──────────────────────────────────────────────────────────────
AUTH_SECRET=                    # generate: openssl rand -base64 32
AUTH_URL=http://localhost:3000
APP_ENCRYPTION_KEY=             # generate: openssl rand -hex 32

# ── AI Model: Pipeshift ───────────────────────────────────────────────
PIPESHIFT_API_KEY=
PIPESHIFT_BASE_URL=https://api.pipeshift.com/api/v0
MODEL_NAME=moonshotai/Kimi-K2.6
MAX_CONTEXT_TOKENS=128000

# ── Long-Context Memory: HydraDB ──────────────────────────────────────
HYDRADB_API_KEY=
HYDRADB_BASE_URL=
HYDRADB_PROJECT_ID=
# If HydraDB gives tenant ID instead, use:
# HYDRADB_TENANT_ID=

# ── Gmail OAuth ───────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/gmail/callback
GMAIL_ALLOWED_LABELS=
GMAIL_ALLOWED_DOMAINS=

# Optional for true Gmail push notifications
GOOGLE_PUBSUB_TOPIC=

# ── Slack OAuth ───────────────────────────────────────────────────────
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_REDIRECT_URI=http://localhost:3000/api/integrations/slack/callback

# ── GitHub OAuth / Webhooks ───────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=

# ── App Settings ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
REALTIME_MODE=sse
DEMO_MODE=false